# Global authentication and runtime settings
username = emtask
password = emtask
# hostkey_file = emtask_hostkey_p256.raw
# authorized_keys_file = authorized_keys
# timeout_ms = 30000
# max_workers = 16
# Bind retry is enabled by default. Useful when a configured NIC/IP appears later.
# Retry interval grows as 1, 2, 4, 8, ... seconds and is capped by bind_retry_max_sec.
# bind_retry = true
# bind_retry_max_sec = 300
# auth_backend = internal
# HTTP/JSON panel. Enabled by default; keep bound to 127.0.0.1 unless protected externally.
# panel_enabled = true
# panel_listen_address = 127.0.0.1
# panel_port = 6024
# panel_auth = none
# panel_auth = token
# panel_auth = otp
# panel_auth = token+otp  # default
# Do not put panel_token or panel_otp_secret in this main config.
# When token/OTP is enabled, emtask loads them from this separate key file.
# If the key file is missing or lacks required keys, random values are generated and saved.
# panel_auth_file = emtask_panel_auth.keys
# Flutter 面板动态添加的子任务会保存到 SQLite；没有 [task ...] 时也可只启动面板后再添加。
# panel_tasks_db_file = emtask_tasks.sqlite3
# Key file format:
#   panel_token = <random-token>
#   panel_otp_secret = <base32-totp-secret>
# If token/OTP is enabled, emtask creates this SVG QR file for client import.
# It embeds token/OTP material and should be protected like a password.
# panel_qr_file = emtask_panel_connect.svg
# panel_qr_mode = always      # default: overwrite/regenerate on every start
# panel_qr_mode = if_missing  # preserve existing file; create only when missing
# panel_qr_mode = disabled    # do not generate QR file
# panel_qr_host = 127.0.0.1
# panel_otp_digits = 6
# panel_otp_step_sec = 60
# panel_otp_window = 1
# Linux only: use /etc/passwd + /etc/shadow password verification instead of password above.
# auth_backend = passwd

[task shell]
listen_address = 0.0.0.0
port = 2222
# working_dir may be absolute, or relative to this config file directory.
# working_dir = .
# SFTP subsystem is enabled by default on this task port. Its root is working_dir (or current dir if empty).
# use_sftp = true
command = cmd.exe /Q /K
# restart_limit = 8
# restart_window_sec = 60
# TUI/reconnect recovery options are enabled by default; keep them here for easy tuning.
# replay_on_attach = true
# repaint_on_attach = true
# screen_snapshot = true
# replay_buffer_bytes = 1048576
# use_conpty = true

[task powershell]
listen_address = 127.0.0.1
port = 2223
# working_dir = C:\\work
# use_sftp = true
command = powershell.exe -NoLogo
# restart_limit = 8
# restart_window_sec = 60
# replay_on_attach = true
# repaint_on_attach = true
# screen_snapshot = true
# replay_buffer_bytes = 1048576
# use_conpty = true

# WindowMsys2 版本建议把 command 配成 MSYS2 shell / 业务命令，例如：
# [task msys2]
# listen_address = 127.0.0.1
# port = 2224
# command = bash -li
