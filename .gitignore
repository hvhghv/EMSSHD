# Build directories
/build*/
/cmake-build*/
build*
# Keep the combined GitHub Actions workflow; the broad build* rule would ignore build.yml.
!/.github/workflows/build.yml
!/.github/scripts/
!/.github/scripts/**
# CMake/Ninja artifacts
CMakeCache.txt
CMakeFiles/
CTestTestfile.cmake
cmake_install.cmake
compile_commands.json
Makefile
build.ninja
.ninja_deps
.ninja_log

*.pdb

# Logs and runtime outputs
*.log
*.out
*.err

# Project runtime/interoperability generated files
/interop_*
/tmp_*
/stdio_fs_root/
emtask_panel_auth.keys
emtask_panel_connect.svg

# Cache/temp
**/.cache
*.tmp
*.temp
*~

# IDE/editor
/.idea/
/.vscode/
*.code-workspace
*.suo
*.user
*.vcxproj.user

# OS files
.DS_Store
Thumbs.db
desktop.ini
